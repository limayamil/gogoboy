# Cadena de conexion de Neon (proyecto "gogoboy").
# Neon Console -> tu proyecto -> Connection string (pooled).
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth (Neon Auth / Managed Better Auth).
# VITE_NEON_AUTH_URL: el Auth Base URL de la consola. El front lo usa; el servidor
# tambien, como fallback, para verificar el JWT contra el JWKS.
# AUTH_ALLOWED_EMAIL: unico correo que la API deja pasar (app de un solo usuario).
VITE_NEON_AUTH_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"
AUTH_ALLOWED_EMAIL="yo@example.com"

# MCP (Grok y otros clientes). Token de maquina, distinto del JWT del browser.
# Solo abre POST /api/mcp (lectura). Generar con: openssl rand -hex 32
AUTH_AGENT_TOKEN="378075cc9f8ea953d0624c09134bde18ca54ee42d17c8fa7826684c910de0955"
# Vercel corre en UTC; sin esto, "hoy" se corre despues de las 21h en Argentina.
GOGOBOY_TZ="America/Argentina/Buenos_Aires"

# Adjuntos: bucket S3-compatible (Neon Object Storage, Cloudflare R2, S3...).
# Ojo con los nombres: el prefijo AWS_* esta reservado en los entornos serverless,
# por eso las variables se llaman S3_* y no AWS_*.
# En produccion se cargan en Vercel: Project Settings -> Environment Variables.
# Para Neon: Console -> Storage -> tu bucket -> credenciales y endpoint.
S3_ENDPOINT="https://br-xxxx.storage.c-2.region.aws.neon.tech"
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
